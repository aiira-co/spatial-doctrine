{
  "name": "spatial/doctrine",
  "description": "Doctrine ORM integration for Spatial PHP Framework with OpenSwoole PostgreSQL driver support.",
  "type": "library",
  "require": {
    "php": "^8.4",
    "doctrine/orm": "^3.3.1",
    "ramsey/uuid-doctrine": "^2.1.0",
    "oro/doctrine-extensions": "^3.0-alpha4",
    "openswoole/core": "^22.1 || ^26.0",
    "spatial/core": "^4.2",
    "symfony/cache": "^6.4 || ^7.0 || ^8.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Kofi Owusu-Afriyie",
      "email": "koathecedi@gmail.com",
      "homepage": "https://aiira.co",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Spatial\\Entity\\": "src/"
    }
  },
  "require-dev": {
    "openswoole/ide-helper": "^4.11"
  },
  "scripts": {
    "test": "php tests/pool-lease-test.php",
    "test:cache": "php tests/doctrine-cache-test.php",
    "test:coroutine": "php tests/coroutine-scope-test.php",
    "test:driver": "php tests/driver-conformance.php"
  }
}
